//* ? using extension: aaron-bond.better-comments

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/**
 * * USERS / PROFILES
 */
model User {
  id       String @id @unique @default(ulid())
  name     String
  email    String @unique
  password String

  /**
   * * Relação usuário-perfil 1:1, um usuário só pode ter 1 perfil.
   * * Justificativa: um usuário COMUM não tem as mesmas permissões
   * * do ADMIN, mas um ADMIN tem acesso como um COMUM e permissões a mais.
   */
  profile   Profile @relation(fields: [profileId], references: [id])
  profileId String  @unique
}

enum AccessLevel {
  ADMIN
  COMUM
}

model Profile {
  id          String      @id @unique @default(ulid())
  accessLevel AccessLevel @default(COMUM)

  //* Relação 1:1 com usuário
  user   User?
  userId String @unique
}

/**
 * * ACADEMIC MODELS
 */

model Serie {
  id       String    @id @unique @default(ulid())
  name     String
  //* uma série pode ter várias turmas
  classes  Class[]
  //* uma série pode ter vários alunos (caso queira armazenar diretamente)
  students Student[]
}

model Teacher {
  id    String @id @unique @default(ulid())
  name  String
  cpf   String @unique
  phone String @unique

  //* Relação 1:1 com a turma (lado inverse optional para evitar ciclo)
  classId String @unique
  class   Class?
}

model Class {
  id   String @id @unique @default(ulid())
  name String

  //* relação 1:N com aluno (1 turma tem muitos alunos)
  students Student[]

  //* relação 1:1 com professor (1 turma tem apenas 1 professor)
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  teacherId String  @unique

  //* Uma turma pode pertencer a uma série
  serie   Serie?  @relation(fields: [serieId], references: [id])
  serieId String?

  //* Aulas da turma
  lessons Lesson[]

  //* horários/ex.: hora_inicio, hora_final, duração (strings ou DateTime dependendo do seu uso)
  startTime String?
  endTime   String?
  duration  String?
}

/**
 * * STUDENT / GUARDIAN (Responsável)
 * * Relação: um RESPONSÁVEL pode ter N ALUNOS (1:N)
 * * No Student guardamos guardianId (FK). Não é @unique, pois um responsável pode ter vários alunos.
 */

model Guardian {
  id     String   @id @unique @default(ulid())
  name   String
  email  String?  @unique
  phones String[]

  //* Relação N:N de endereço
  addresses Address[] @relation("GuardianAddresses")

  //* Relação 1:N -> vários alunos
  students Student[]
}

model Student {
  id        String   @id @unique @default(ulid())
  name      String
  birthdate DateTime

  //* Relação N:1 com turma (1 turma tem muitos alunos)
  class   Class  @relation(fields: [classId], references: [id])
  classId String

  //* Relação N:1 com guardian (um responsável pode ter vários alunos)
  guardian   Guardian @relation(fields: [guardianId], references: [id])
  guardianId String

  //* parentesco do aluno com o responsável (ex: mãe, pai, tutor)
  kinship String

  /**
   * * Relação N:N de aluno e endereço.
   * * Um aluno pode ter mais de um endereço,
   * * e um endereço pode pertencer a mais de um aluno.
   */
  addresses Address[] @relation("StudentAddresses") //* Gera tabela intermediária (studentID, addressID)

  //* Matrículas do aluno
  enrollments Enrollment[]

  //* Frequências / presenças
  attendances Attendance[]

  //* série cursada (opcional se você já tem por turma)
  serieId String?
  serie   Serie?  @relation(fields: [serieId], references: [id])
}

/**
 * * ADDRESS (N:N com Student e Guardian)
 */

model Address {
  id         String  @id @unique @default(ulid())
  street     String
  number     String
  district   String
  complement String?

  //* Relações N:N ->
  students  Student[]  @relation("StudentAddresses") //* Gera tabela (studentID, addressID)
  guardians Guardian[] @relation("GuardianAddresses") //* Gera tabela (guardianID, addressID)
}

/**
 * * ENROLLMENT / CONTRACT / PAYMENT (Matrícula / Contrato / Mensalidade)
 */

model Contract {
  id          String       @id @unique @default(ulid())
  startDate   DateTime
  endDate     DateTime?
  document    String?
  signatureAt DateTime?
  enrollments Enrollment[]
}

model Enrollment {
  id         String    @id @unique @default(ulid())
  student    Student   @relation(fields: [studentId], references: [id])
  studentId  String
  contract   Contract  @relation(fields: [contractId], references: [id])
  contractId String
  status     String //* ex: ativa, cancelada, pendente
  enrolledAt DateTime  @default(now())
  payments   Payment[]
}

model Payment {
  id           String     @id @unique @default(ulid())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  enrollmentId String
  amount       Float
  dueDate      DateTime
  paidAt       DateTime?
  status       String //* ex: PENDENTE, PAGO, ATRASADO
}

/**
 * * LESSON / ATTENDANCE (Aula / Frequência)
 */

model Lesson {
  id          String       @id @unique @default(ulid())
  date        DateTime
  topic       String?
  class       Class        @relation(fields: [classId], references: [id])
  classId     String
  attendances Attendance[]
}

model Attendance {
  id        String  @id @unique @default(ulid())
  status    String //* presente / ausente / justificativa
  student   Student @relation(fields: [studentId], references: [id])
  studentId String
  lesson    Lesson  @relation(fields: [lessonId], references: [id])
  lessonId  String

  @@unique([studentId, lessonId])
}
